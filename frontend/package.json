  },
  "devDependencies": {
    "@react-facet/core": "18.6.0",
    "@react-facet/dom-fiber": "18.6.0",
    "@types/react": "18.3.28",
    "esbuild": "0.28.2",
    "react": "18.2.0",
    "react-test-renderer": "18.2.0",
    "typescript": "7.0.2"
  }
}
