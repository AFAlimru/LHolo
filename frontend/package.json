{
  "name": "lholo-oreui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node tests/menu.cjs",
